{
  "name": "rivetkit-xstate",
  "version": "0.1.0",
  "description": "Embed XState finite state machines as RivetKit actors",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "rivetkit",
    "xstate",
    "state-machine",
    "fsm",
    "actors",
    "stateful"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "rivet": "^0.x || ^1.x",
    "xstate": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0",
    "rivet": "^0.1.0",
    "xstate": "^5.18.0"
  },
  "dependencies": {},
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jog1t/rivetkit-xstate.git"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
